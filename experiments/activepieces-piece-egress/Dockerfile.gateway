FROM docker.io/library/node:24.8.0-bookworm-slim@sha256:cadbfafeb6baf87eaaffa40b3640209c4b7fd38cebde65059d15bc39cd636b85
WORKDIR /gateway
COPY gateway.mjs provider-manifest.mjs ip-policy.mjs ./
RUN chown -R 65532:65532 /gateway && chmod -R go-w /gateway
ENV NODE_ENV=production
USER 65532:65532
ENTRYPOINT ["node", "/gateway/gateway.mjs"]
