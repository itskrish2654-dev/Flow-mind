NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public support/privacy contact. The UI shows an explicit owner-action
# placeholder until this is configured; it never invents an address.
SUPPORT_EMAIL=
# Canonical padded standard Base64 for exactly 32 random bytes (44 characters).
FLOWMIND_CREDENTIAL_MASTER_KEY=
FLOWMIND_RATE_LIMIT_SECRET=
# At least 32 random characters. Signs generic webhook endpoints server-side.
FLOWMIND_CONNECTOR_ENDPOINT_SECRET=
# Google connector server configuration. Client secrets and service-account
# credentials must never use a NEXT_PUBLIC_ prefix.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact OIDC audience and service-account email configured on the authenticated
# Pub/Sub push subscription.
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Full topic resource name: projects/<project-id>/topics/<topic-name>
GOOGLE_GMAIL_PUBSUB_TOPIC=
# Slack public app (server-only). Enable PKCE, and configure the OAuth redirect
# plus signed Events API endpoint documented in docs/CONNECTORS_SLACK_NOTION.md.
FLOWMIND_CONNECTOR_SLACK_CLIENT_ID=
FLOWMIND_CONNECTOR_SLACK_CLIENT_SECRET=
FLOWMIND_CONNECTOR_SLACK_SIGNING_SECRET=
# Notion public connection (server-only). The webhook verification token is the
# one-time token delivered by Notion while registering the production endpoint.
FLOWMIND_CONNECTOR_NOTION_CLIENT_ID=
FLOWMIND_CONNECTOR_NOTION_CLIENT_SECRET=
FLOWMIND_CONNECTOR_NOTION_WEBHOOK_VERIFICATION_TOKEN=
FLOWMIND_AI_EXECUTION_MODEL=llama-3.3-70b-versatile
FLOWMIND_AI_EXECUTION_TIMEOUT_MS=20000
FLOWMIND_AI_MAX_INPUT_CHARS=20000
FLOWMIND_AI_MAX_OUTPUT_TOKENS=1000
# Required in the browser for Supabase Auth CAPTCHA-protected signup, sign-in,
# and recovery. Store the matching secret in Supabase Auth Bot and Abuse
# Protection; never expose that secret as NEXT_PUBLIC_*.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Used only when a hosted public form is explicitly set to Turnstile mode.
TURNSTILE_SECRET_KEY=
# Required by Vercel Cron to authenticate the internal maintenance route.
CRON_SECRET=
# Optional release label outside Vercel; Vercel deployments use the Git SHA.
FLOWMIND_RELEASE=
