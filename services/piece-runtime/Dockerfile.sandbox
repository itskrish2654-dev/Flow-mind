FROM docker.io/library/node:24.8.0-bookworm-slim@sha256:cadbfafeb6baf87eaaffa40b3640209c4b7fd38cebde65059d15bc39cd636b85

WORKDIR /piece-runtime
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force
COPY src ./src
RUN chown -R 65532:65532 /piece-runtime && chmod -R go-w /piece-runtime

ENV NODE_ENV=production HOME=/home/sandbox
USER 65532:65532
ENTRYPOINT ["node", "/piece-runtime/src/worker.mjs"]
