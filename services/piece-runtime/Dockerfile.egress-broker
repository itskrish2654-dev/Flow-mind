FROM docker.io/library/node:24.8.0-bookworm-slim@sha256:cadbfafeb6baf87eaaffa40b3640209c4b7fd38cebde65059d15bc39cd636b85

WORKDIR /piece-egress-broker
COPY src/deep-freeze.mjs src/errors.mjs src/build-registry.mjs src/manifest-registry.mjs src/ip-policy.mjs src/dns-policy.mjs src/tls-client-hello.mjs ./src/
COPY src/egress-broker-constants.mjs src/egress-broker-control.mjs src/egress-broker.mjs ./src/
RUN chown -R 65532:65532 /piece-egress-broker && chmod -R go-w /piece-egress-broker

ENV NODE_ENV=production
USER 65532:65532
ENTRYPOINT ["node", "/piece-egress-broker/src/egress-broker.mjs"]
